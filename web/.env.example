# Copy to .env.local for local dev. In Vercel, set these under Project Settings → Environment Variables.

# Supabase — Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # safe to expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # SECRET — server-only, never NEXT_PUBLIC_, never committed

# Resend — resend.com/api-keys (needs a verified sending domain for production sends)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Smooth Application <hello@yourdomain.com>"

# This deployment's own public URL — used to build links inside emails
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Random secret string — protects /api/cron/send-reminders from being called by anyone else.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
